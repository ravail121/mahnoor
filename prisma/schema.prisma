generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model availability {
  id         Int      @id @default(autoincrement())
  doctor_id  Int
  date       DateTime @db.Date
  time_slot  DateTime @db.Time(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  doctors    doctors  @relation(fields: [doctor_id], references: [id], onDelete: Cascade, map: "fk_availability_doctor")

  @@unique([doctor_id, date, time_slot], map: "uq_availability_doctor_date_time")
  @@index([date], map: "idx_availability_date")
}

model bookings {
  id             Int                     @id @default(autoincrement())
  doctor_id      Int
  patient_id     Int
  session_type   bookings_session_type
  date           DateTime                @db.Date
  time_slot      DateTime                @db.Time(0)
  status         bookings_status         @default(tentative)
  payment_status bookings_payment_status @default(unpaid)
  amount_paid    Decimal                 @default(0.00) @db.Decimal(10, 2)
  total_fee      Decimal                 @default(0.00) @db.Decimal(10, 2)
  notes          String?                 @db.Text
  zoom_meeting_id String?                @db.VarChar(50)
  zoom_join_url  String?                 @db.VarChar(500)
  zoom_start_url String?                 @db.VarChar(500)
  created_at     DateTime                @default(now()) @db.Timestamptz(0)
  doctors        doctors                 @relation(fields: [doctor_id], references: [id], map: "fk_bookings_doctor")
  patients       patients                @relation(fields: [patient_id], references: [id], map: "fk_bookings_patient")
  payments       payments[]

  @@index([doctor_id, date], map: "idx_bookings_doctor_date")
  @@index([patient_id], map: "idx_bookings_patient")
  @@index([status], map: "idx_bookings_status")
}

model doctors {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(150)
  specialty       String            @db.VarChar(150)
  created_at      DateTime          @default(now()) @db.Timestamptz(0)
  availability    availability[]
  bookings        bookings[]
  users           users[]
  weekly_schedule weekly_schedule[]
}

model patients {
  id          Int                  @id @default(autoincrement())
  name        String               @db.VarChar(150)
  phone       String               @db.VarChar(30)
  age         Int?                 @db.SmallInt
  booking_for patients_booking_for @default(self)
  created_at  DateTime             @default(now()) @db.Timestamptz(0)
  bookings    bookings[]
  users       users[]

  @@index([phone], map: "idx_patients_phone")
}

model payments {
  id          Int             @id @default(autoincrement())
  booking_id  Int
  amount      Decimal         @db.Decimal(10, 2)
  method      payments_method
  gateway_ref String?         @db.VarChar(255)
  status      payments_status @default(pending)
  created_at  DateTime        @default(now()) @db.Timestamptz(0)
  bookings    bookings        @relation(fields: [booking_id], references: [id], onDelete: Cascade, map: "fk_payments_booking")

  @@index([booking_id], map: "idx_payments_booking")
  @@index([status], map: "idx_payments_status")
}

model saved_payment_methods {
  id           Int             @id @default(autoincrement())
  user_id      Int
  method       payments_method
  label        String          @db.VarChar(120)
  account_hint String?         @db.VarChar(80)
  is_default   Boolean         @default(false)
  created_at   DateTime        @default(now()) @db.Timestamptz(0)
  users        users           @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_saved_payment_methods_user")

  @@index([user_id], map: "idx_saved_payment_methods_user")
}

model users {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(150)
  email                 String?                 @unique(map: "uq_users_email") @db.VarChar(191)
  phone                 String?                 @unique(map: "uq_users_phone") @db.VarChar(30)
  password_hash         String                  @db.VarChar(255)
  role                  users_role              @default(patient)
  patient_id            Int?                    @unique(map: "uq_users_patient_id")
  doctor_id             Int?                    @unique(map: "uq_users_doctor_id")
  avatar_url            String?                 @db.VarChar(500)
  password_reset_token  String?                 @unique(map: "uq_users_password_reset_token") @db.VarChar(191)
  password_reset_expiry DateTime?               @db.Timestamptz(0)
  created_at            DateTime                @default(now()) @db.Timestamptz(0)
  doctors               doctors?                @relation(fields: [doctor_id], references: [id], map: "fk_users_doctor")
  patients              patients?               @relation(fields: [patient_id], references: [id], map: "fk_users_patient")
  saved_payment_methods saved_payment_methods[]

  @@index([role], map: "idx_users_role")
  @@index([created_at], map: "idx_users_created_at")
}

model contact_messages {
  id         Int                     @id @default(autoincrement())
  name       String                  @db.VarChar(150)
  phone      String                  @db.VarChar(30)
  message    String                  @db.Text
  status     contact_messages_status @default(new)
  created_at DateTime                @default(now()) @db.Timestamptz(0)

  @@index([status], map: "idx_contact_messages_status")
  @@index([created_at], map: "idx_contact_messages_created_at")
}

model weekly_schedule {
  id         Int      @id @default(autoincrement())
  doctor_id  Int
  weekday    Int      @db.SmallInt
  time_slot  DateTime @db.Time(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  doctors    doctors  @relation(fields: [doctor_id], references: [id], onDelete: Cascade, map: "fk_weekly_schedule_doctor")

  @@unique([doctor_id, weekday, time_slot], map: "uq_weekly_schedule_doctor_weekday_time")
  @@index([doctor_id, weekday, is_active], map: "idx_weekly_schedule_doctor_weekday_active")
}

enum bookings_session_type {
  in_person
  online
}

enum payments_method {
  card
  jazzcash
  easypaisa
  bank
}

enum patients_booking_for {
  self
  family_member
}

enum payments_status {
  pending
  success
  failed
  refunded
}

enum bookings_status {
  tentative
  confirmed
  cancelled
  completed
}

enum bookings_payment_status {
  unpaid
  paid
  refunded
}

enum users_role {
  patient
  admin
}

enum contact_messages_status {
  new
  read
  replied
}
