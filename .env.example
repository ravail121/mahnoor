# Self-hosted Postgres (Docker) — used for local dev and for production
# on your own server (e.g. EC2). See docker-compose.yml for how these are
# used to run Postgres + Adminer, and docker-compose.app.yml for the app.
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=change-me

# Host-dev value (running `npm run dev` directly, not in Docker) — connects
# to Postgres via the port published on localhost.
DATABASE_URL="postgresql://clinic_user:change-me@localhost:5432/clinic_db"
DIRECT_URL="postgresql://clinic_user:change-me@localhost:5432/clinic_db"
# When the app itself runs inside Docker (docker-compose.app.yml), it
# overrides these two to point at the `clinic_postgres` service by name
# instead — you don't need to change anything here for that.

# Only used by docker-compose.app.yml (the app container). Defaults to 80 —
# override if that port's unavailable, e.g. for local Docker testing.
# APP_PORT=80

# Auth.js
AUTH_SECRET=generate-a-long-random-secret
# Local dev (npm run dev): http://localhost:3002 (or whatever port you run on)
# Docker/production: the real public URL of this server, e.g. https://yourclinic.com
# (must match APP_PORT above if not the default http/https port)
AUTH_URL=http://localhost:3002

# Zoom (Server-to-Server OAuth app) — optional. When set, verifying an online
# booking's payment auto-creates a Zoom meeting and includes the join/start
# links in the WhatsApp messages. Leave unset to skip Zoom entirely (calendar
# invites still work either way). Create the app at marketplace.zoom.us
# (Build App → Server-to-Server OAuth) under the doctor's own Zoom account.
# ZOOM_ACCOUNT_ID=your-zoom-account-id
# ZOOM_CLIENT_ID=your-zoom-client-id
# ZOOM_CLIENT_SECRET=your-zoom-client-secret
